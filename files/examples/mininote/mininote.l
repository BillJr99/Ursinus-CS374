/* mininote.l : flex specification for the mini-notation subset.
   Each rule pairs a regular expression with a C action.
   Compile chain:  flex mininote.l  ->  lex.yy.c            */

%{
#include "mininote.tab.h"   /* token codes generated by bison */
#include <stdlib.h>
#include <string.h>
%}

%option noyywrap

%%

[a-zA-Z][a-zA-Z0-9]*   { yylval.str = strdup(yytext); return WORD;   }
[0-9]+                 { yylval.num = atoi(yytext);   return NUMBER; }
"~"                    { return REST;   }
"["                    { return LBRACK; }
"]"                    { return RBRACK; }
"*"                    { return STAR;   }
"/"                    { return SLASH;  }
"?"                    { return QMARK;  }
[ \t\r\n]+             { /* whitespace separates tokens; discard */  }
.                      { fprintf(stderr, "[lexer] unexpected character '%s'\n", yytext); }

%%
