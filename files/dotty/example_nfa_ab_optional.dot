digraph example_nfa_ab_optional {
  rankdir=LR;
  bgcolor="transparent";
  label="coral = newly accepting after ε-removal";
  labelloc=b; fontname="Helvetica"; fontsize=12;
  node [shape=circle, fontname="Helvetica", fontsize=14, style=filled, fillcolor="#E6F4EC", color="#5FAE84", fontcolor="#1F5C3D"];
  edge [fontname="Courier", fontsize=13, color="#666666"];
  __start [shape=point, style=invis, width=0];
  q1 [shape=doublecircle, fillcolor="#FCE6DE", color="#D9805F", fontcolor="#8A3A1E"];
  q2 [shape=doublecircle];
  __start -> q0;
  q0 -> q1 [label="a"];
  q0 -> q2 [label="a"];
  q1 -> q2 [label="b"];
}
