digraph contains_aa_partial {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=circle, fontname="Helvetica", fontsize=14];
  edge [fontname="Courier", fontsize=13];
  __start [shape=point, style=invis, width=0];
  q0;
  q_a;
  q_seen [shape=doublecircle];
  unk_q_a    [label="?", style=dashed, color=gray50, fontcolor=gray40];
  unk_q_seen [label="?", style=dashed, color=gray50, fontcolor=gray40];
  __start -> q0;
  q0 -> q_a [label="a"];
  q0 -> q0  [label="b"];
  q_a    -> unk_q_a    [label="a ?", style=dashed, color=gray50, fontcolor=gray40];
  q_a    -> unk_q_a    [label="b ?", style=dashed, color=gray50, fontcolor=gray40];
  q_seen -> unk_q_seen [label="a ?", style=dashed, color=gray50, fontcolor=gray40];
  q_seen -> unk_q_seen [label="b ?", style=dashed, color=gray50, fontcolor=gray40];
  {rank=same; q_a; q_seen;}
}
