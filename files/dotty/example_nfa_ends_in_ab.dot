digraph example_nfa_ends_in_ab {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=circle, fontname="Helvetica", fontsize=14, style=filled, fillcolor="#EEECFB", color="#8C82D0", fontcolor="#3B3480"];
  edge [fontname="Courier", fontsize=13, color="#666666"];
  __start [shape=point, style=invis, width=0];
  q2 [shape=doublecircle];
  __start -> q0;
  q0 -> q0 [label="a,b"];
  q0 -> q1 [label="a"];
  q1 -> q2 [label="b"];
}
