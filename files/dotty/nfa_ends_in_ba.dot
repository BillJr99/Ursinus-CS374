digraph nfa_ends_in_ba {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=circle, fontname="Helvetica", fontsize=14];
  edge [fontname="Courier", fontsize=13];
  __start [shape=point, style=invis, width=0];
  q0;
  q1;
  q2 [shape=doublecircle];
  __start -> q0;
  q0 -> q0 [label="b,a"];
  q0 -> q1 [label="b"];
  q1 -> q2 [label="a"];
}
