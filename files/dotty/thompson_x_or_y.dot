digraph thompson_x_or_y {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=circle, fontname="Helvetica", fontsize=14];
  edge [fontname="Courier", fontsize=13];
  6 [shape=doublecircle];
  __s0 [shape=point, style=invis, width=0];
  __s0 -> 5;
  1 -> 2 [label="x"];
  3 -> 4 [label="y"];
  5 -> 1 [label="ε", style=dashed];
  5 -> 3 [label="ε", style=dashed];
  2 -> 6 [label="ε", style=dashed];
  4 -> 6 [label="ε", style=dashed];
}
