digraph dragon_nfa_abb {
  rankdir=LR; bgcolor="transparent"; nodesep=0.5; ranksep=0.9;
  fontname="Helvetica"; fontsize=12; labelloc=b;
  node [shape=circle, fixedsize=true, width=0.62, fontname="Helvetica-Bold", fontsize=14, style=filled];
  edge [fontname="Helvetica", fontsize=13, color="#333333", fontcolor="#555555", arrowsize=0.8];
  __start [shape=point, style=invis, width=0];
  node [fillcolor="#EEECFB", color="#5A4FC0", fontcolor="#3B3480"];
  label="dashed edge = ε-move";
  10 [shape=doublecircle];
  __start -> 0;
  0 -> 1 [label="ε", style=dashed];
  1 -> 2 [label="ε", style=dashed];
  1 -> 4 [label="ε", style=dashed];
  2 -> 3 [label="a"];
  4 -> 5 [label="b"];
  3 -> 6 [label="ε", style=dashed];
  5 -> 6 [label="ε", style=dashed];
  6 -> 1 [label="ε", style=dashed, constraint=false];
  6 -> 7 [label="ε", style=dashed];
  0 -> 7 [label="ε", style=dashed];
  7 -> 8 [label="a"];
  8 -> 9 [label="b"];
  9 -> 10 [label="b"];
}
