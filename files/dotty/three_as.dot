digraph three_as {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=circle, fontname="Helvetica", fontsize=14];
  edge [fontname="Courier", fontsize=13];
  __start [shape=point, style=invis, width=0];
  q3 [shape=doublecircle];
  __start -> q0;
  q0 -> q1 [label="a"];
  q0 -> q0 [label="b"];
  q1 -> q2 [label="a"];
  q1 -> q0 [label="b"];
  q2 -> q3 [label="a"];
  q2 -> q0 [label="b"];
  q3 -> q3 [label="a, b"];
}
