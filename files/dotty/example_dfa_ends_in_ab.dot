digraph example_dfa_ends_in_ab {
  rankdir=LR; bgcolor="transparent"; nodesep=0.5; ranksep=0.9;
  fontname="Helvetica"; fontsize=12; labelloc=b;
  node [shape=circle, fixedsize=true, width=0.62, fontname="Helvetica-Bold", fontsize=14, style=filled, group=row];
  edge [fontname="Helvetica", fontsize=13, color="#333333", fontcolor="#555555", arrowsize=0.8];
  __start [shape=point, style=invis, width=0, group=row];
  label="A = {q0}   |   B = {q0, q1}   |   C = {q0, q2}";
  node [fillcolor="#E2F4EC", color="#1F7A52", fontcolor="#174D35"];
  C [shape=doublecircle];
  __start -> A;
  A -> A [label="b"];
  A -> B [label="a"];
  B -> B [label="a"];
  B -> C [label="b"];
  C -> B [label="a", constraint=false];
  C -> A [label="b", constraint=false];
}
