digraph even_ones {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=circle, fontname="Helvetica", fontsize=14];
  edge [fontname="Courier", fontsize=13];
  __start [shape=point, style=invis, width=0];
  even [shape=doublecircle];
  odd;
  __start -> even;
  even -> even [label="0"];
  even -> odd  [label="1"];
  odd  -> odd  [label="0"];
  odd  -> even [label="1"];
}
