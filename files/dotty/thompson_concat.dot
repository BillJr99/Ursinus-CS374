digraph thompson_concat {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=circle, fontname="Helvetica", fontsize=14];
  edge [fontname="Courier", fontsize=13];
  __start [shape=point, style=invis, width=0];
  __start -> 1;
  1 -> 2 [label="a"];
  2 -> 9 [label="ε"];
  subgraph cluster_star {
    label="(b | c)*"; fontname="Courier"; fontsize=13;
    style="rounded"; color=gray70;
    9;
  10 [shape=doublecircle];
  subgraph cluster_alt {
    label="b | c"; labelloc=b; fontname="Courier"; fontsize=13;
    style="rounded,dashed"; color=gray50; margin=14;
    7; 5; 6; 3; 4; 8;
    7 -> 3 [label="ε"];
    7 -> 5 [label="ε"];
    3 -> 4 [label="b"];
    5 -> 6 [label="c"];
    4 -> 8 [label="ε"];
    6 -> 8 [label="ε"];
  }
  9 -> 7  [label="ε"];
  8 -> 7  [xlabel="ε", constraint=false];
  8 -> 10 [label="ε"];
  9 -> 10 [label="ε"];
  }
}
