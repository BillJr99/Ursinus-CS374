digraph ends_in_ab {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=circle, fontname="Helvetica", fontsize=14];
  edge [fontname="Courier", fontsize=13];
  __start [shape=point, style=invis, width=0];
  q0;
  q_a;
  q_ab [shape=doublecircle];
  __start -> q0;
  q0   -> q_a  [label="a"];
  q0   -> q0   [label="b"];
  q_a  -> q_a  [label="a"];
  q_a  -> q_ab [label="b"];
  q_ab -> q_a  [label="a"];
  q_ab -> q0   [label="b"];
}
