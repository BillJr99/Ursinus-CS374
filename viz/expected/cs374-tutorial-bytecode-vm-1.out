  4           0 RESUME                   0

  5           2 LOAD_FAST                0 (a)
              4 LOAD_FAST                1 (b)
              6 BINARY_OP                0 (+)
             10 RETURN_VALUE

 10           0 RESUME                   0

 11           2 LOAD_FAST                0 (n)
              4 LOAD_CONST               1 (1)
              6 COMPARE_OP              26 (<=)
             10 POP_JUMP_IF_FALSE        2 (to 16)

 12          12 LOAD_FAST                0 (n)
             14 RETURN_VALUE

 13     >>   16 LOAD_GLOBAL              1 (NULL + fib)
             26 LOAD_FAST                0 (n)
             28 LOAD_CONST               1 (1)
             30 BINARY_OP               10 (-)
             34 CALL                     1
             42 LOAD_GLOBAL              1 (NULL + fib)
             52 LOAD_FAST                0 (n)
             54 LOAD_CONST               2 (2)
             56 BINARY_OP               10 (-)
             60 CALL                     1
             68 BINARY_OP                0 (+)
             72 RETURN_VALUE
