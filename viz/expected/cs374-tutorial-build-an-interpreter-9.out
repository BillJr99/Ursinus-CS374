(+ 1 2)                                  => ['+', 1, 2]
(define x 42)                            => ['define', 'x', 42]
(lambda (x) (* x x))                     => ['lambda', ['x'], ['*', 'x', 'x']]
(if #t 1 0)                              => ['if', True, 1, 0]
(let ((x 5)) (+ x 1))                    => ['let', [['x', 5]], ['+', 'x', 1]]
