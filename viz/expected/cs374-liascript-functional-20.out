let:   x=11, y=12, x+y=23
       Note: y used outer_x (10), NOT the new x (11)

let*:  x=1, y=2, x+y=3
       Note: y used the new x (1), giving y=2

letrec: even?(4) = True
letrec: odd?(7)  = True
        Note: even? and odd? reference each other - impossible with let or let*

--- Parallel swap (let) vs sequential (let*) ---
let  swap: a=7, b=3  (correct parallel swap)
let* swap: a=7, b=7  (WRONG - new_a leaked into new_b)
