  '2+3*4'            -> ('+', ('num', 2.0), ('*', ('num', 3.0), ('num', 4.0)))
  '2*3+4'            -> ('+', ('*', ('num', 2.0), ('num', 3.0)), ('num', 4.0))
  '(2+3)*4'          -> ('*', ('+', ('num', 2.0), ('num', 3.0)), ('num', 4.0))
  '7-2-1'            -> ('-', ('-', ('num', 7.0), ('num', 2.0)), ('num', 1.0))
  '-3*2'             -> ('*', ('neg', ('num', 3.0)), ('num', 2.0))
  '1+2+3+4'          -> ('+', ('+', ('+', ('num', 1.0), ('num', 2.0)), ('num', 3.0)), ('num', 4.0))
