{"version": 2, "width": 100, "height": 30, "title": "A flex scanner, then the bison calculator", "code_viz_provenance": "recorded", "duration": 1.512}
[0.0, "m", "Check the tools"]
[0.0, "o", "$ flex --version\r\n"]
[0.056, "o", "flex 2.6.4\r\n"]
[0.101, "o", "$ bison --version\r\n"]
[0.15, "o", "bison (GNU Bison) 3.8.2\r\nWritten by Robert Corbett and Richard Stallman.\r\n\r\nCopyright (C) 2021 Free Software Foundation, Inc.\r\nThis is free software; see the source for copying conditions.  There is NO\r\nwarranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.\r\n"]
[0.202, "o", "$ gcc --version\r\n"]
[0.266, "o", "gcc (GCC) 14.4.0\r\nCopyright (C) 2024 Free Software Foundation, Inc.\r\nThis is free software; see the source for copying conditions.  There is NO\r\nwarranty; not even for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.\r\n\r\n"]
[0.303, "m", "Generate the scanner"]
[0.303, "o", "$ flex -o hello.c hello.l\r\n"]
[0.303, "o", ""]
[0.404, "m", "Compile the scanner"]
[0.404, "o", "$ gcc -o hello hello.c -lfl\r\n"]
[0.404, "o", ""]
[0.605, "m", "Scan the sample input"]
[0.605, "o", "$ echo \"hello 42 world 99\" | ./hello\r\n"]
[0.674, "o", "WORD: hello\r\nNUMBER: 42\r\nWORD: world\r\nNUMBER: 99\r\n\r\n"]
[0.706, "m", "Build the calculator"]
[0.706, "o", "$ make\r\n"]
[0.761, "o", "bison -d calc.y           # -d generates the header file calc.tab.h\r\nflex calc.l\r\ngcc -Wall -g -o calc calc.tab.c lex.yy.c -lfl -lm\r\n"]
[0.896, "o", "\u001b[01m\u001b[Klex.yy.c:1237:16:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[K'\u001b[01m\u001b[Kinput\u001b[m\u001b[K' defined but not used [\u001b[01;35m\u001b[K-Wunused-function\u001b[m\u001b[K]\r\n 1237 |     static int \u001b[01;35m\u001b[Kinput\u001b[m\u001b[K  (void)\r\n      |                \u001b[01;35m\u001b[K^~~~~\u001b[m\u001b[K\r\n\u001b[01m\u001b[Klex.yy.c:1190:17:\u001b[m\u001b[K \u001b[01;35m\u001b[Kwarning: \u001b[m\u001b[K'\u001b[01m\u001b[Kyyunput\u001b[m\u001b[K' defined but not used [\u001b[01;35m\u001b[K-Wunused-function\u001b[m\u001b[K]\r\n 1190 |     static void \u001b[01;35m\u001b[Kyyunput\u001b[m\u001b[K (int c, char * yy_bp )\r\n      |                 \u001b[01;35m\u001b[K^~~~~~~\u001b[m\u001b[K\r\n"]
[1.007, "m", "Evaluate an expression"]
[1.007, "o", "$ echo \"3 + 4 * 2\" | ./calc\r\n"]
[1.074, "o", "Mini Calculator. Enter expressions (Ctrl-D to quit).\r\n= 11\r\n"]
[1.108, "o", "$ echo \"x = 5\" | ./calc\r\n"]
[1.174, "o", "Mini Calculator. Enter expressions (Ctrl-D to quit).\r\nx = 5\r\n"]
[1.209, "m", "Keep state in one process"]
[1.209, "o", "$ echo -e \"x = 5\\nx * x\" | ./calc\r\n"]
[1.272, "o", "Mini Calculator. Enter expressions (Ctrl-D to quit).\r\nx = 5\r\n= 25\r\n"]
[1.31, "o", "$ echo \"2 ^ 10\" | ./calc\r\n"]
[1.384, "o", "Mini Calculator. Enter expressions (Ctrl-D to quit).\r\n= 1024\r\n"]
[1.411, "m", "Multiply negative values"]
[1.411, "o", "$ echo \"-3 * -4\" | ./calc\r\n"]
[1.482, "o", "Mini Calculator. Enter expressions (Ctrl-D to quit).\r\n= 12\r\n"]
