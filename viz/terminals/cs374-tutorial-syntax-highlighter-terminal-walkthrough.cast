{"version": 2, "width": 100, "height": 30, "title": "Generate and test a tree-sitter parser", "code_viz_provenance": "scripted", "duration": 0.003}
[0.0, "m", "Install the generator"]
[0.0, "o", "$ npm install -g tree-sitter-cli\r\n"]
[0.0, "o", "added 1 package\n"]
[0.001, "m", "Generate parser source"]
[0.001, "o", "$ tree-sitter generate\r\n"]
[0.001, "o", ""]
[0.002, "m", "Inspect the tree for a short input"]
[0.002, "o", "$ echo 'let x = 2 + 3 * 4; print x;' | tree-sitter parse /dev/stdin\r\n"]
[0.002, "o", "Named syntax nodes for the declaration and print statement.\n"]
